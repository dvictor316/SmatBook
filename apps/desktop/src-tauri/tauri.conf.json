{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../shell",
    "distDir": "../shell"
  },
  "package": {
    "productName": "SmartProbook",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Business",
      "copyright": "SmartProbook",
      "identifier": "com.smartprobook.desktop",
      "targets": "all"
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 820,
        "minHeight": 700,
        "minWidth": 1100,
        "resizable": true,
        "title": "SmartProbook",
        "url": "index.html",
        "width": 1280
      }
    ]
  }
}
