{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../shell",
    "distDir": "../shell"
  },
  "package": {
    "productName": "SmartProbook",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Business",
      "copyright": "SmartProbook",
      "identifier": "com.smartprobook.desktop",
      "icon": ["icons/icon.png", "icons/icon.ico"],
      "targets": "all",
      "windows": {
        "wix": {
          "fragmentPaths": ["wix/desktop-protocol.wxs"],
          "componentRefs": ["SmartProbookProtocolRegistration"]
        }
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/dvictor316/SmatBook/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3QTM4QUUwRTE0N0E4NEEKUldSS3FFZmg0SXFqdDQ0KzRjR1ZBY05xKzlDdHYzVkxteXZXaWxvR0ZSb2hnSXJlaXB2SWxuWUkK",
      "windows": {
        "installMode": "passive"
      }
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 820,
        "minHeight": 700,
        "minWidth": 1100,
        "resizable": true,
        "title": "SmartProbook",
        "url": "index.html",
        "width": 1280
      }
    ]
  }
}
