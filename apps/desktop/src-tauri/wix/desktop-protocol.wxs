<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <DirectoryRef Id="TARGETDIR">
            <Component Id="SmartProbookProtocolRegistration" Guid="*">
                <RegistryKey Root="HKCU" Key="Software\Classes\smartprobook">
                    <RegistryValue Type="string" Value="URL:SmartProbook Protocol" />
                    <RegistryValue Name="URL Protocol" Type="string" Value="" KeyPath="yes" />
                    <RegistryKey Key="DefaultIcon">
                        <RegistryValue Type="string" Value="&quot;[!Path]&quot;,0" />
                    </RegistryKey>
                    <RegistryKey Key="shell\open\command">
                        <RegistryValue Type="string" Value="&quot;[!Path]&quot; &quot;%1&quot;" />
                    </RegistryKey>
                </RegistryKey>
            </Component>
        </DirectoryRef>
    </Fragment>
</Wix>
